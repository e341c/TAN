# Copy to deploy/.env and adjust before: docker compose -f deploy/docker-compose.yml up --build

POSTGRES_USER=tan
POSTGRES_PASSWORD=change_me
POSTGRES_DB=tan_predictions
# Host port for DBeaver/psql (containers use hostname postgres, not localhost)
POSTGRES_PORT=5432
DATABASE_URL=postgresql://tan:change_me@postgres:5432/tan_predictions
# From your machine: postgresql://tan:change_me@localhost:5432/tan_predictions
# Also used by trading_bot to persist order history (trading_orders table)

QUANTILE_MODEL_RUN=2026-08-17T09-39-47
TREND_MODEL_RUN=2026-08-17T15-47-17
TREND_REALTIME_CONFIG=technical_analysis_trainer/models/trend/test_config.yaml

PREDICTION_SYMBOL=BTCUSDT
PREDICTION_INTERVAL=1h
# Must cover the longest feature warm-up (168-bar HAR-RV window + seq_len).
# 45 was the retired 7-feature model's size and yields zero usable bars for the
# current one; set here because this env value OVERRIDES assembly/config.yaml.
PREDICTION_BINANCE_LIMIT=400

ALLOWED_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:80

WEB_PORT=80

# Trading bot (optional — paper mode needs no keys)
# BINANCE_API_KEY=
# BINANCE_API_SECRET=
# STATE_PATH=/var/lib/trading_bot/state.json
# TAN_TRADING_BOT_IMAGE=ghcr.io/YOUR_GITHUB_USER/tan-trading-bot:latest

# Production (GHCR) — set on EC2 when using docker-compose.prod.yml
# TAN_API_IMAGE=ghcr.io/YOUR_GITHUB_USER/tan-api:latest
# TAN_WEB_IMAGE=ghcr.io/YOUR_GITHUB_USER/tan-web:latest
