# Copy to deploy/.env and adjust before: docker compose -f deploy/docker-compose.yml up --build

POSTGRES_USER=tan
POSTGRES_PASSWORD=change_me
POSTGRES_DB=tan_predictions
DATABASE_URL=postgresql://tan:change_me@postgres:5432/tan_predictions

QUANTILE_MODEL_RUN=2026-05-08T01-04-55
TREND_MODEL_RUN=2026-04-18T07-04-16
TREND_REALTIME_CONFIG=technical_analysis_trainer/models/trend/test_config.yaml

PREDICTION_SYMBOL=BTCUSDT
PREDICTION_INTERVAL=1h
PREDICTION_BINANCE_LIMIT=45

ALLOWED_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:80

WEB_PORT=80

# Production (GHCR) — set on EC2 when using docker-compose.prod.yml
# TAN_API_IMAGE=ghcr.io/YOUR_GITHUB_USER/tan-api:latest
# TAN_WEB_IMAGE=ghcr.io/YOUR_GITHUB_USER/tan-web:latest
